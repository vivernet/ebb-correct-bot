{
  "name": "ebb-correct-bot",
  "version": "2.0.0",
  "description": "Telegram-бот для корректуры русскоязычных текстов через OpenAI-совместимый API.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:deno": "deno run --allow-env --allow-net src/deno.js",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/deno.js"
  },
  "author": "vivernet <alex.1501@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivernet/ebb-correct-bot"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.22.4",
    "openai": "^4.57.0"
  },
  "engines": {
    "node": ">=20"
  }
}
