[Unit]
Description=Ebb Correct Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/ebb-correct-bot
Environment=NODE_ENV=production
EnvironmentFile=/etc/ebb-correct-bot.env
ExecStart=/usr/bin/node /opt/ebb-correct-bot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ebb-correct-bot

[Install]
WantedBy=multi-user.target
