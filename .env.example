# Telegram
TELEGRAM_BOT_TOKEN=
# Необязательно: адрес самостоятельно развёрнутого Telegram Bot API.
TELEGRAM_BOT_API_URL=

# API, совместимый с OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
MODEL_ID=gpt-5.4-mini

# Идентификаторы пользователей Telegram, которым разрешено пользоваться ботом; перечисляются через запятую.
ALLOWED_USER_IDS=
# Необязательно: идентификатор чата для служебных уведомлений.
ADMIN_CHAT_ID=
# Укажите false, только если сообщения неавторизованных пользователей должны оставаться в чате.
DELETE_UNAUTHORIZED_MESSAGES=true

# Настройки вебхука Deno Deploy. URL должен оканчиваться указанным ниже маршрутом.
TELEGRAM_WEBHOOK_URL=https://your-project.deno.dev/telegram
# Сгенерируйте случайное значение для этого секрета: оно защищает конечную точку.
TELEGRAM_WEBHOOK_SECRET=
