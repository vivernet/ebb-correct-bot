# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Для публичного Telegram API используйте HTTPS. Локальный Bot API также должен быть доступен по HTTPS.
TELEGRAM_BOT_API_URL=https://api.telegram.org

# OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Обязательный стабильный ключ группировки Prompt Caching.
OPENAI_PROMPT_CACHE_KEY=ebb-correct-bot-v1
OPENAI_MAX_OUTPUT_TOKENS=1000
# Таймаут одного запроса к модели.
REQUEST_TIMEOUT_MS=30000
INPUT_MAX_LENGTH=12000
# Общий лимит одновременно выполняемых запросов к модели.
MAX_CONCURRENT_REQUESTS=3

# Доступ
ALLOWED_USER_IDS=
ADMIN_CHAT_ID=
TELEGRAM_LOG_CHAT_ID=
DELETE_UNAUTHORIZED_MESSAGES=true

# Deno Deploy webhook
TELEGRAM_WEBHOOK_URL=https://ebb-correct-bot.{organization-slug}.deno.net/telegram
TELEGRAM_WEBHOOK_SECRET=
# Должен быть не меньше REQUEST_TIMEOUT_MS.
WEBHOOK_CALLBACK_TIMEOUT_MS=35000
