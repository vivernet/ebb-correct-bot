# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Необязательно: URL Telegram Bot API.
TELEGRAM_BOT_API_URL=https://api.telegram.org

# OpenAI API
OPENAI_API_KEY=
# Необязательно: базовый URL OpenAI API. По умолчанию используется официальный API OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
# Идентификатор используемой модели OpenAI.
OPENAI_MODEL=gpt-5.6-luna
# Ключ для группировки запросов при использовании Prompt Caching.
OPENAI_PROMPT_CACHE_KEY=ebb-correct-bot-v1
# Максимум выходных токенов (max_output_tokens).
OPENAI_MAX_OUTPUT_TOKENS=1000

# Идентификаторы пользователей Telegram, которым разрешено пользоваться ботом; значения перечисляются через запятую.
ALLOWED_USER_IDS=
# Необязательно: идентификатор чата Telegram для отправки служебных уведомлений.
ADMIN_CHAT_ID=
# Если true, сообщения неавторизованных пользователей удаляются; если false, они остаются в чате.
DELETE_UNAUTHORIZED_MESSAGES=true

# Настройки вебхука Deno Deploy.
TELEGRAM_WEBHOOK_URL=https://ebb-correct-bot.{organization-slug}.deno.net/telegram
# Секретный токен для защиты конечной точки вебхука от несанкционированных запросов.
TELEGRAM_WEBHOOK_SECRET=
