# Telegram
TELEGRAM_BOT_TOKEN=
# Optional: a self-hosted Telegram Bot API endpoint.
TELEGRAM_BOT_API_URL=

# OpenAI-compatible API
OPENAI_API_KEY=
# Defaults to the provider used by the legacy project; replace for another compatible API.
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
MODEL_ID=gpt-5.4-mini

# Comma-separated Telegram user IDs that may use the bot.
ALLOWED_USER_IDS=
# Optional chat ID for operational alerts.
ADMIN_CHAT_ID=
# Set false only if unauthorized messages must remain in the chat.
DELETE_UNAUTHORIZED_MESSAGES=true

# Deno Deploy webhook settings. The URL must end with the route used below.
TELEGRAM_WEBHOOK_URL=https://your-project.deno.dev/telegram
# Generate a different random value for this secret; it protects the endpoint.
TELEGRAM_WEBHOOK_SECRET=
